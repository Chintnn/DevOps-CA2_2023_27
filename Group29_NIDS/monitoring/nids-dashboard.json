{
  "title": "NIDS API",
  "uid": "nids-api",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Uptime",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "time() - process_start_time_seconds{job=\"nids-api\"}" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Latency p95",
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Error rate",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) / sum(rate(http_requests_total[1m]))" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Attacks detected (5m)",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(increase(ids_predictions_total{label!=\"normal\"}[5m]))" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Requests per second",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_requests_total[1m])) by (path)" } ]
    }
  ]
}